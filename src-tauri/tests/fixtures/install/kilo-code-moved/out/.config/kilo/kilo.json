{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "handoff": {
      "type": "local",
      "command": [
        "/apps/Baton/handoff-mcp"
      ],
      "environment": {
        "HANDOFF_AGENT": "kilo-code",
        "HANDOFF_TOOL_TIMEOUT_MS": "1800000"
      },
      "timeout": 1800000
    },
    "docs": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@example/docs-mcp"
      ]
    }
  }
}
