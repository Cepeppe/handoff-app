{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // The e2e driver of tests/e2e/ is run by Node's own type stripping (`node main.ts`),
    // which resolves modules the way the ESM loader does and therefore needs the extension
    // written out. Nothing is emitted here, so this only permits the form; src/ keeps its
    // extensionless imports.
    "allowImportingTsExtensions": true,
    // `svelte` carries the ambient declaration of a `*.svelte` module, without which an
    // import of a component is an unresolved module for `tsc` and for the editor. `node`
    // is for the two files that run outside the webview: the Vite configuration and the
    // source-scanning test.
    "types": ["vite/client", "svelte", "node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "tests", "vite.config.ts"]
}
